<% layout('layout/boilerPlate') %>


<div class="container mt-4">
    <h1 class="text-center mb-4">Edit Camp</h1>
    <div class="row">
        <!-- Camp Information Section -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white text-center">
                    <h3 class="card-title mb-0"><%= camp.title %></h3>
                </div>
                <div class="card-body p-3">
                    <div class="text-center">
                        <img src="<%= camp.image %>" alt="<%= camp.title %> image" class="img-fluid mb-2" style="max-height: 300px;">
                    </div>
                    <p class="card-text"><b>Location:</b> <%= camp.location %></p>
                    <p class="card-text"><b>Price:</b> $<%= camp.price %></p>
                    <p class="card-text"><b>Place:</b> <span style="color:grey;"><%= camp.place %></span></p>
                    <p class="card-text"><b>Submitted By:</b> <span style="color:grey;"><%= camp.author.username %></span></p>
                    <p class="card-text"><b>Description:</b> <small><%= camp.description %></small></p>

                    <% if (current_user && camp.author.equals(current_user._id)) { %>
                        <div class="text-center mt-3">
                            <form action="/campgrounds/<%= camp._id %>?_method=DELETE" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger btn-sm">DELETE</button>
                            </form>
                    <% } %>
                            <a href="/campgrounds" class="btn btn-secondary btn-sm">Back</a>
                            <a href="/campgrounds/<%= camp._id %>/edit" class="btn btn-warning btn-sm">Edit</a>
                        </div>            
                </div>
            </div>
        </div>

        <!-- Review Section -->
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title text-center">Leave a Review</h5>
                    <form action="/campgrounds/<%= camp._id %>/review" method="post">
                        <div class="form-group">
                            <label for="reviewText">Your Review</label>
                            <textarea class="form-control" name="review" id="reviewText" rows="3" required placeholder="Write your review here"></textarea>
                        </div>
                        <div class="form-group">
                            <label for="rating">Rating</label>
                            <div id="rating" class="star-rating" style="direction: rtl; font-size: 2rem; display: inline-flex;">
                                <input type="radio" id="star5" name="rating" value="5" required style="display: none;">
                                <label for="star5" title="5 stars" style="color: #ccc; cursor: pointer; transition: color 0.3s;">&#9733;</label>
                        
                                <input type="radio" id="star4" name="rating" value="4" style="display: none;">
                                <label for="star4" title="4 stars" style="color: #ccc; cursor: pointer; transition: color 0.3s;">&#9733;</label>
                        
                                <input type="radio" id="star3" name="rating" value="3" style="display: none;">
                                <label for="star3" title="3 stars" style="color: #ccc; cursor: pointer; transition: color 0.3s;">&#9733;</label>
                        
                                <input type="radio" id="star2" name="rating" value="2" style="display: none;">
                                <label for="star2" title="2 stars" style="color: #ccc; cursor: pointer; transition: color 0.3s;">&#9733;</label>
                        
                                <input type="radio" id="star1" name="rating" value="1" style="display: none;">
                                <label for="star1" title="1 star" style="color: #ccc; cursor: pointer; transition: color 0.3s;">&#9733;</label>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Submit</button>
                    </form>
                </div>
            </div>

<!-- Reviews Display Section -->
<div class="card">
    <div class="card-body">
        <h4 class="card-title text-center mb-4">Reviews</h4>
        <div class="row">
            <% if (camp.reviews.length > 0) { %>
                <% for (let review of camp.reviews) { %>
                    <div class="col-md-12 mb-3">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Review:</h5>
                                <p class="card-text"><%= review.body %></p>
                                
                                <h6 class="card-subtitle mb-2 text-muted">
                                    <div class="star-rating" style="font-size: 1.2rem;">
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <% if (i <= review.rating) { %>
                                                <span style="color: #f5c518;">&#9733;</span> <!-- Filled star -->
                                            <% } else { %>
                                                <span style="color: #ccc;">&#9733;</span> <!-- Empty star -->
                                            <% } %>
                                        <% } %>
                                    </div>
                                    <b>Author: <%= review.author.username %></b>
                                </h6>
                                
                                <form action="/campgrounds/<%= camp._id %>/review/<%= review._id %>?_method=DELETE" method="post">
                                    <button type="submit" class="btn btn-danger w-85">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% } %>
            <% } else { %>
                <p class="text-center">No reviews available.</p>
            <% } %>
        </div>
    </div>
</div>

        </div>
    </div>
</div>
<script>
    // JavaScript to handle hover and checked states
    document.querySelectorAll('.star-rating label').forEach(label => {
        label.addEventListener('mouseover', function () {
            const stars = Array.from(label.parentElement.children);
            stars.forEach(star => {
                star.style.color = star.previousElementSibling === this.previousElementSibling || star.previousElementSibling?.checked ? '#f5c518' : '#ccc';
            });
        });

        label.addEventListener('mouseout', function () {
            const stars = Array.from(label.parentElement.children);
            stars.forEach(star => {
                star.style.color = star.previousElementSibling?.checked ? '#f5c518' : '#ccc';
            });
        });

        label.previousElementSibling.addEventListener('change', function () {
            const stars = Array.from(label.parentElement.children);
            stars.forEach(star => {
                star.style.color = star.previousElementSibling?.checked ? '#f5c518' : '#ccc';
            });
        });
    });
</script>